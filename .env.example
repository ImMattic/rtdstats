# Database (override for local dev outside Docker)
DATABASE_URL=postgresql+asyncpg://rtdstats:rtdstats@localhost:5432/rtdstats

# GTFS-RT feed URLs (RTD Denver public feeds)
GTFS_RT_VEHICLE_URL=https://www.rtd-denver.com/files/gtfs-rt/VehiclePosition.pb
GTFS_RT_TRIP_URL=https://www.rtd-denver.com/files/gtfs-rt/TripUpdate.pb

# How often to poll the RTD feeds (seconds)
POLLING_INTERVAL_SECONDS=30

# Minutes a vehicle must be stationary before triggering a stuck alert
STUCK_VEHICLE_MINUTES=5

# Comma-separated allowed CORS origins
CORS_ORIGINS=["http://localhost:3000"]
